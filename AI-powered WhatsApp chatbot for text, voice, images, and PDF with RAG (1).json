    {
      "parameters": {
        "jsCode": "let requests = $(\"Download Document File\").all()\n\nrequests.forEach((request) => {\n  let mime_type = request.json.mime_type\n\n  if (\n    mime_type === \"text/calendar\" || \n    mime_type === \"application/ics\" || \n    mime_type === \"text/x-calendar\"\n  ) {\n    request.json.mime_type = \"mapped/calendar\"\n  }\n\n  if (\n    mime_type === \"application/xml\" || \n    mime_type === \"text/xml\") {\n    request.json.mime_type = \"mapped/xml\"\n  }\n\n  if (!mime_type) {\n    request.json.mime_type = $('Get Document URL').first().json.mime_type\n  }\n})\n\nreturn requests;"
      },
      "id": "788b8a1c-555e-48d2-82e4-4459903fe3d3",
      "name": "Normalize MIME Types",
